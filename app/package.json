{
  "name": "yt-dlp-studio",
  "version": "0.1.0",
  "description": "A Material Design desktop studio for yt-dlp, with yt-dlp and ffmpeg bundled so nothing has to be installed separately.",
  "author": "Ding Ding Projects",
  "license": "Unlicense",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dist": "electron-vite build && electron-builder --win squirrel",
    "design": "node ../scripts/design-reference-server.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:catalog": "node ../scripts/check-catalog-drift.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^38.1.0",
    "electron-builder": "^26.0.12",
    "electron-builder-squirrel-windows": "^26.0.12",
    "electron-vite": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  }
}
